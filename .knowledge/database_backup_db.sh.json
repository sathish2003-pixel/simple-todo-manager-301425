{"is_source_file": true, "format": "bash", "description": "A shell script designed to detect and back up various types of databases (SQLite, PostgreSQL, MySQL, MongoDB). It performs checks for database existence and runs appropriate backup commands accordingly.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "mysqladmin ping -h localhost -P ${DB_PORT}", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup script", "SQLite backup", "PostgreSQL backup", "MySQL backup", "MongoDB backup", "detect and backup database", "database detection script"], "state": 2, "file_id": 8, "knowledge_revision": 16, "git_revision": "6d7f9de70980c3c37202e42240d9ee5c77923b3e", "hash": "d7da372b768c895a33088027314656c3", "format-version": 4, "code-base-name": "database", "filename": "database/backup_db.sh", "revision_history": [{"16": "6d7f9de70980c3c37202e42240d9ee5c77923b3e"}]}